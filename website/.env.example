# Settings read when the site is built. Copy to `.env` to change them locally; `.env` is not committed.

# Where the Offers section reads the dairy's live offers.
# Left unset, the site reads the dairy's server, which publishes the offers running today that need no code:
#   https://amrale-dairy-api.amrale-dairy-website.workers.dev/public/offers.json
# Set it to another server's address, or to /offers.json to use a file uploaded with the site instead.
# PUBLIC_OFFERS_URL=https://amrale-dairy-api.amrale-dairy-website.workers.dev/public/offers.json
