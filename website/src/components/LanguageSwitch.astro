---
import { languages, switchLanguagePath, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** `pill` in the header bar, `block` inside the mobile menu, `link` in the footer. */
  variant?: 'pill' | 'block' | 'link';
}

const { lang, variant = 'pill' } = Astro.props;
const other = switchLanguagePath(Astro.url.pathname);
---

<a
  class={`switch switch-${variant}`}
  href={other.href}
  hreflang={ui[other.lang].htmlLang}
  lang={ui[other.lang].htmlLang}
  aria-label={ui[lang].a11y.switchLanguage}
  data-lang-switch={other.lang}
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"></path>
  </svg>
  <span>{languages[other.lang]}</span>
</a>

<script>
  // Remember the choice: BaseLayout opens the site in the language chosen last time.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('amrale-lang', a.dataset.langSwitch ?? '');
      } catch {
        // Private browsing: the switch still works, it just is not remembered.
      }
    }),
  );
</script>

<style>
  .switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .switch span {
    font-family: var(--font-marathi-body);
  }

  .switch-pill {
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1.5px solid var(--blue-100);
    background: var(--milk);
    color: var(--blue-800);
    font-size: 15px;
  }

  .switch-pill:hover {
    border-color: var(--blue-700);
    background: var(--blue-50);
  }

  .switch-block {
    min-height: 48px;
    margin-top: 6px;
    border-radius: 999px;
    border: 1.5px solid var(--blue-100);
    color: var(--blue-800);
    font-size: 16px;
  }

  .switch-link {
    color: var(--yellow);
    font-size: 15px;
  }

  .switch-link:hover {
    text-decoration: underline;
  }
</style>
