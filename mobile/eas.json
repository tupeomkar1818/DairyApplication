{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "counter": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SERVICE_MODE": "api",
        "EXPO_PUBLIC_API_BASE_URL": "https://amrale-dairy-api.amrale-dairy-website.workers.dev"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SERVICE_MODE": "api",
        "EXPO_PUBLIC_API_BASE_URL": "https://amrale-dairy-api.amrale-dairy-website.workers.dev"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SERVICE_MODE": "api",
        "EXPO_PUBLIC_API_BASE_URL": "https://amrale-dairy-api.amrale-dairy-website.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
